HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
# Production: đặt HTTPS ở reverse proxy, APP_ORIGIN chính xác và COOKIE_SECURE=1.
COOKIE_SECURE=0
# Dữ liệu demo được tạo một lần. Dùng SEED_DEMO=0 khi triển khai dữ liệu thật.
SEED_DEMO=1
# Tùy chọn: tạo quản trị viên đầu tiên từ biến môi trường (dùng cho hosting không có Shell như Render Free).
# ADMIN_EMAIL=admin@smart.edu.vn
# ADMIN_PASSWORD=
# Nếu đặt ADMIN_PASSWORD, mỗi lần khởi động tài khoản ADMIN_EMAIL được khôi phục đúng mật khẩu, quyền admin và trạng thái mở.
# Tùy chọn: đăng nhập bằng Google. Chỉ cần Client ID công khai (không cần client secret).
# Tạo tại Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application),
# thêm URL trang web vào Authorized JavaScript origins.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Tùy chọn AI trực tuyến; khóa chỉ được đọc tại máy chủ.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# Nếu dùng thêm Vercel: URL production chính xác, không có dấu / ở cuối.
# ADDITIONAL_ORIGINS=https://ten-web.vercel.app
# DATA_DIR=/var/data/smart-student
# Tùy chọn: lưu dữ liệu trên Turso (SQLite đám mây, có gói miễn phí) để không mất khi Render Free ngủ/deploy.
# Khi đặt hai biến này, DATA_DIR chỉ còn dùng cho file tạm.
# TURSO_DATABASE_URL=libsql://ten-db-ten-ban.turso.io
# TURSO_AUTH_TOKEN=
