{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "public",
  "routes": [
    {
      "src": "/(.*)",
      "dest": "https://YOUR-SERVICE.onrender.com/$1",
      "headers": {
        "Cache-Control": "no-store",
        "x-vercel-enable-rewrite-caching": "0"
      }
    }
  ]
}
